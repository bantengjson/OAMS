# Salin ke backend/.env untuk pengembangan lokal.
NODE_ENV=development
PORT=4000

# Database lokal dari `npm run dev:db` (PostgreSQL tertanam, port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oams

# Minimal 32 karakter. Produksi: openssl rand -base64 48
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter-panjang
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Jakarta

# Super Admin awal yang dibuat oleh `npm run prisma:seed`.
# Login bisa memakai email atau username. Password hanya dipakai saat akun dibuat.
SEED_ADMIN_EMAIL=admin@kantor.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_NAME=Super Admin
