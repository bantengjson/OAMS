// OAMS - skema database Tahap 1 (Foundation)
// Konvensi: tabel snake_case jamak, kolom snake_case, UUID sebagai primary key,
// waktu disimpan sebagai timestamptz (UTC).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Pengguna, role, permission
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  /// Optional short login name (lower-case), e.g. "admin". Email always works too.
  username     String?   @unique @db.VarChar(50)
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  departmentId String?   @map("department_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  department    Department?    @relation(fields: [departmentId], references: [id])
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  responsibleAssets Asset[]         @relation("AssetResponsible")
  createdAssets     Asset[]         @relation("AssetCreatedBy")
  archivedAssets    Asset[]         @relation("AssetArchivedBy")
  uploadedPhotos    AssetPhoto[]
  uploadedDocuments AssetDocument[]

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  module      String @db.VarChar(50)
  description String

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users  User[]
  assets Asset[]

  @@map("departments")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assets Asset[]

  @@map("categories")
}

enum LocationType {
  OFFICE
  BUILDING
  FLOOR
  ROOM
}

model Location {
  id          String       @id @default(uuid()) @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  type        LocationType
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(150)
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  assets   Asset[]

  @@index([parentId])
  @@index([type])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Sesi dan audit
// ---------------------------------------------------------------------------

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([module, createdAt])
  @@index([entityId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Tahap 2: inventaris barang, label QR, foto, dokumen
// ---------------------------------------------------------------------------

enum OwnershipType {
  OFFICE
  THIRD_PARTY
}

enum AcquisitionMethod {
  PURCHASE
  GRANT
  LOAN
  OTHER
}

enum AssetCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  UNUSABLE
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  STORED
  BORROWED
  UNDER_MAINTENANCE
  MISSING
  DISPOSED
  RETURNED
}

model Asset {
  id                String            @id @default(uuid()) @db.Uuid
  assetCode         String            @unique @map("asset_code") @db.VarChar(30)
  name              String            @db.VarChar(200)
  categoryId        String            @map("category_id") @db.Uuid
  brand             String?           @db.VarChar(100)
  model             String?           @db.VarChar(100)
  serialNumber      String?           @map("serial_number") @db.VarChar(100)
  description       String?
  ownershipType     OwnershipType     @map("ownership_type")
  acquisitionMethod AcquisitionMethod @map("acquisition_method")
  acquisitionDate   DateTime?         @map("acquisition_date") @db.Date
  purchasePrice     Decimal?          @map("purchase_price") @db.Decimal(15, 2)
  vendor            String?           @db.VarChar(150)
  locationId        String            @map("location_id") @db.Uuid
  departmentId      String?           @map("department_id") @db.Uuid
  condition         AssetCondition
  status            AssetStatus
  responsibleUserId String?           @map("responsible_user_id") @db.Uuid
  notes             String?
  archivedAt        DateTime?         @map("archived_at") @db.Timestamptz(6)
  archivedById      String?           @map("archived_by_id") @db.Uuid
  archiveReason     String?           @map("archive_reason")
  createdById       String?           @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  category        Category        @relation(fields: [categoryId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  responsibleUser User?           @relation("AssetResponsible", fields: [responsibleUserId], references: [id])
  createdBy       User?           @relation("AssetCreatedBy", fields: [createdById], references: [id])
  archivedBy      User?           @relation("AssetArchivedBy", fields: [archivedById], references: [id])
  label           AssetLabel?
  photos          AssetPhoto[]
  documents       AssetDocument[]

  @@index([categoryId])
  @@index([locationId])
  @@index([departmentId])
  @@index([responsibleUserId])
  @@index([status])
  @@index([condition])
  @@index([archivedAt])
  @@index([name])
  @@map("assets")
}

/// Penomoran Asset Code per tahun; diperbarui atomik dalam transaksi pembuatan barang.
model AssetCodeSequence {
  year       Int @id
  lastNumber Int @map("last_number")

  @@map("asset_code_sequences")
}

model AssetLabel {
  id            String    @id @default(uuid()) @db.Uuid
  assetId       String    @unique @map("asset_id") @db.Uuid
  publicToken   String    @unique @map("public_token") @db.VarChar(64)
  isActive      Boolean   @default(true) @map("is_active")
  generatedAt   DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  printedCount  Int       @default(0) @map("printed_count")
  lastPrintedAt DateTime? @map("last_printed_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_labels")
}

model AssetPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  width        Int?
  height       Int?
  isPrimary    Boolean  @default(false) @map("is_primary")
  caption      String?  @db.VarChar(255)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([assetId])
  @@map("asset_photos")
}

model AssetDocument {
  id           String   @id @default(uuid()) @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  title        String?  @db.VarChar(200)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([assetId])
  @@map("asset_documents")
}
