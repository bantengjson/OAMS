# Salin ke .env di server, isi nilai yang kosong. Jangan commit file .env.

# --- PostgreSQL (container postgres) ---
POSTGRES_DB=oams
POSTGRES_USER=oams
# Hanya huruf/angka (mis. `openssl rand -hex 32`): nilai ini masuk ke URL koneksi.
POSTGRES_PASSWORD=

# Dipakai backend di dalam jaringan Docker
DATABASE_URL=postgresql://oams:${POSTGRES_PASSWORD}@postgres:5432/oams

# --- Backend ---
NODE_ENV=production
PORT=4000
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Jakarta

# Super Admin awal (dibuat saat seed; ganti password setelah login pertama).
# Login bisa memakai email atau username.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# --- Frontend / Nginx ---
# Alamat dasar yang dimasukkan ke QR Code; tetapkan domain final sebelum cetak stiker
PUBLIC_BASE_URL=https://inventaris.domainkantor.com
API_URL=http://backend:4000
